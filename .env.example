# Copy to .env and adjust.
DATABASE_URL="postgresql://yakka:yakka@localhost:5432/yakka?schema=public"
BASE_URL="http://localhost:3000"
CRON_SECRET=""

# Web Push (generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Extra push service hosts to accept (FCM, Mozilla, Apple and WNS always are).
PUSH_ALLOWED_HOSTS=""

ENABLE_GROUP_DELETION="true"
ALLOW_JOIN_FROM_TAG_DEFAULT="true"

# Optional: e.g. "plausible" or "umami"; empty disables analytics.
ANALYTICS_PROVIDER=""

# Outbound webhooks may target LAN addresses (Home Assistant etc.).
# Default when empty: "true" self-hosted, "false" on Vercel. Set to "false" on
# ANY public instance where strangers can create groups: otherwise anyone can
# make your server POST to your internal network (SSRF).
WEBHOOK_ALLOW_PRIVATE_NETWORKS=""

# Optional: also send due/overdue notices to ntfy and/or Apprise. INSTANCE-WIDE:
# every group's notices (with group links) go to one place, so only set these
# on a self-hosted instance used by a single household. Off when empty.
# NTFY_URL is a full topic URL, e.g. https://ntfy.sh/my-household-chores
NTFY_URL=""
NTFY_TOKEN=""
# APPRISE_URL is an Apprise API notify endpoint, e.g. http://apprise:8000/notify/yakka
APPRISE_URL=""

# Database provider: inferred from DATABASE_URL (`file:` = SQLite); set to
# "sqlite" to force it. SQLite example: DATABASE_URL="file:./data/yakka.db"
DATABASE_PROVIDER=""

# In-process cron (every 5 min). The Docker image sets this to true; leave
# false on Vercel (use Vercel Cron) and in development.
ENABLE_INTERNAL_CRON="false"

# Rate limiting in src/proxy.ts (per instance, in memory).
RATE_LIMIT_ENABLED="true"
# The one header that holds the client IP: x-forwarded-for (default; Vercel:
# x-vercel-forwarded-for), x-real-ip, cf-connecting-ip, x-vercel-forwarded-for
# or none (all clients share one bucket). See docs/DEPLOYMENT.md.
RATE_LIMIT_IP_HEADER=""
# With x-forwarded-for: reverse proxies that append to it in front of the app.
RATE_LIMIT_PROXY_HOPS="1"

# Build a standalone server (.next/standalone) as the Docker image does.
# `next start` refuses standalone builds, so leave unset locally.
# NEXT_OUTPUT="standalone"

# Register the service worker under `next dev` (run `npm run sw:build -- --dev` first).
# NEXT_PUBLIC_ENABLE_SW="true"
